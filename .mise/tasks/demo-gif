#!/bin/sh
#MISE description="Render the README demo animation into docs/demo.gif (commit the result)"
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"
frames="$(mktemp -d)"
trap 'rm -rf "$frames"' EXIT
python3 -I docs/demo/frames.py "$frames" | swift docs/demo/render.swift docs/demo.gif 1
echo "docs/demo.gif: $(du -h docs/demo.gif | cut -f1)"
