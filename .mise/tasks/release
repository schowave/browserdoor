#!/bin/sh
#MISE description="Release a version: check, tag, push the tag, follow the release workflow"
#USAGE arg "<tag>" help="Version tag, e.g. v0.5.2"
# Before running it: review the changes since the last tag (`/code-review high <last tag>`)
# add a "## <tag>" section to CHANGELOG.md (rename "## Unreleased") and push main. That
# section goes on top of the generated release notes.
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"
fail() { echo "release: $1" >&2; exit 1; }

tag="${1:-}"
case "$tag" in
  v[0-9]*.[0-9]*.[0-9]*) ;;
  *) fail "usage: mise run release vX.Y.Z" ;;
esac
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || fail "not on main"
[ -z "$(git status --porcelain)" ] || fail "uncommitted changes"
git fetch -q origin main --tags
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] \
  || fail "main and origin/main differ (pull, or push your commits first)"
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then fail "$tag exists already"; fi
# The tag's section of CHANGELOG.md: from "## <tag>" up to the next "## ".
notes="$(awk -v tag="$tag" '/^## /{inside = ($2 == tag)} inside && !/^## /' CHANGELOG.md | sed '/./,$!d')"
[ -n "$notes" ] || fail "CHANGELOG.md has no \"## $tag\" section"

mise run ci

# The repo requires annotated tags.
git tag -a "$tag" -m "$tag"
git push -q origin "$tag"
echo "release: pushed $tag, waiting for the release workflow…"

run=""
for _ in $(seq 30); do
  run="$(gh run list --workflow release.yml --limit 5 --json databaseId,headBranch \
    --jq "[.[] | select(.headBranch == \"$tag\")][0].databaseId // empty")"
  [ -n "$run" ] && break
  sleep 5
done
[ -n "$run" ] || fail "no release run for $tag showed up"
gh run watch "$run" --exit-status || fail "release workflow failed: gh run view $run --log-failed"

body="$(gh release view "$tag" --json body --jq .body)"
gh release edit "$tag" --notes "$(printf '%s\n\n%s\n' "$notes" "$body")" >/dev/null
echo "release: put the CHANGELOG.md section on top of the release notes"
formula="$(gh api repos/schowave/homebrew-tap/contents/Formula/browserdoor.rb --jq .content | base64 -d)"
echo "$formula" | grep -q "/tags/$tag.tar.gz" || fail "the tap formula does not point at $tag"
echo "release: $tag is out, and schowave/tap/browserdoor points at it"
