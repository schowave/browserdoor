#!/bin/sh
#MISE description="Test the release helper scripts against a throwaway git repo"
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"
tasks="$(pwd)/.mise/tasks"
repo="$(mktemp -d)"
trap 'rm -rf "$repo"' EXIT
fail() { echo "test-scripts: $1" >&2; exit 1; }

git -C "$repo" init -q
git -C "$repo" config user.email test@example.invalid
git -C "$repo" config user.name test
git -C "$repo" config tag.gpgSign false
mkdir -p "$repo/.mise/tasks" "$repo/Sources" "$repo/.github"
cp "$tasks/_lib.sh" "$tasks/next-patch-version" "$tasks/app-changed-since-release" "$tasks/release" "$repo/.mise/tasks/"
echo a > "$repo/Sources/a.swift"
git -C "$repo" add -A && git -C "$repo" commit -qm init

run() { (cd "$repo" && ".mise/tasks/$1"); }
run_appcast() { (cd "$repo" && .mise/tasks/appcast "$@"); }
run_release() { (cd "$repo" && git checkout -q -B not-main && .mise/tasks/release "$1"); }

[ -z "$(run next-patch-version)" ] || fail "next-patch-version without tags should print nothing"
run app-changed-since-release || fail "without tags everything counts as changed"

for t in v0.1.0 v0.1.9 v0.1.10 v0.2.0-rc.1 v-junk; do git -C "$repo" tag "$t"; done
[ "$(run next-patch-version)" = "v0.1.11" ] || fail "expected v0.1.11, got $(run next-patch-version)"
git -C "$repo" tag v1.0.0
[ "$(run next-patch-version)" = "v1.0.1" ] || fail "expected v1.0.1"

if run app-changed-since-release; then fail "no change since v1.0.0 must not count"; fi
echo ci > "$repo/.github/x.yml" && git -C "$repo" add -A && git -C "$repo" commit -qm ci
if run app-changed-since-release; then fail "CI-only change must not count"; fi
echo b > "$repo/Sources/a.swift" && git -C "$repo" add -A && git -C "$repo" commit -qm src
run app-changed-since-release || fail "a Sources change must count"

# release accepts only vMAJOR.MINOR.PATCH; anything else stops before git or GitHub is touched.
for t in "" v1.2 v1.2.3-rc1 v1.2.3.4 1.2.3 "v1.2.3 x"; do
  out="$(run_release "$t" 2>&1)" && fail "release accepted '$t'"
  echo "$out" | grep -q "usage:" || fail "release '$t' should fail with usage, got: $out"
done
out="$(run_release v1.2.3 2>&1)" || true
echo "$out" | grep -q "not on main" || fail "release should accept v1.2.3 and stop at the branch check, got: $out"

rendered="$("$tasks/render-formula" 1.2.3 abc file:///tmp/x.tar.gz)"
echo "$rendered" | grep -q 'url "file:///tmp/x.tar.gz"' || fail "render-formula ignores the url argument"
# appcast: the tag's CHANGELOG section as HTML, the enclosure with sign_update's attributes.
mkdir -p "$repo/Resources"
cp "$tasks/appcast" "$repo/.mise/tasks/"
cp Resources/Info.plist "$repo/Resources/"
# shellcheck disable=SC2016 # Markdown backticks, not command substitution
printf '%s\n' '# Changelog' '' '## v1.2.4 – 2026-01-02' '' '- Opens `a<b` *now*' '- Second & last' '' '## v1.2.3' '' '- old' > "$repo/CHANGELOG.md"
signature='sparkle:edSignature="QUJD+/=" length="42"'
feed="$(run_appcast v1.2.4 https://example.invalid/B.dmg "$signature")" || fail "appcast failed: $feed"
echo "$feed" | xmllint --noout - || fail "appcast is not well-formed XML"
echo "$feed" | grep -qF '<li>Opens <code>a&lt;b</code> <em>now</em></li>' || fail "appcast notes: $feed"
echo "$feed" | grep -qF '<li>Second &amp; last</li>' || fail "appcast should escape &"
echo "$feed" | grep -q 'old' && fail "appcast took notes from another version"
echo "$feed" | grep -qF "<enclosure url=\"https://example.invalid/B.dmg\" type=\"application/octet-stream\" $signature/>" \
  || fail "appcast enclosure: $feed"
echo "$feed" | grep -qF '<sparkle:version>1.2.4</sparkle:version>' || fail "appcast version"
feed="$(run_appcast v1.2.5 https://x.invalid/B.dmg "$signature")" || fail "appcast without CHANGELOG section failed: $feed"
echo "$feed" | xmllint --noout - || fail "appcast without notes is not well-formed XML"
echo "$feed" | grep -qF 'releases/tag/v1.2.5">Release notes on GitHub' || fail "appcast without CHANGELOG section should link the release: $feed"
run_appcast v1.2.4 https://x.invalid/B.dmg 'length="1"' >/dev/null 2>&1 && fail "appcast must reject odd sign_update output"

echo "test-scripts: ok"
