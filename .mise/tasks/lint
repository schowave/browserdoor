#!/bin/sh
#MISE description="Lint workflows, shell scripts and Swift formatting"
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"
actionlint
# Every shell task (they have no extension), so a new one can't be missed.
{ echo .mise/tasks/_lib.sh; grep -l '^#!/bin/sh' .mise/tasks/*; } | sort -u | xargs shellcheck
swiftformat --lint .
