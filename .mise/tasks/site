#!/bin/sh
#MISE description="Assemble the homepage in build/site from site/ and the shared images (deployed by pages.yml)"
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"
out="$BUILD_DIR/site"
rm -rf "$out"
mkdir -p "$out"
cp site/style.css site/copy.js "$out/"
# GitHub Pages lets browsers cache files for 10 minutes and reuse them after that; a version from
# the file's content makes a changed stylesheet or script load at once.
version() { shasum -a 256 "site/$1" | cut -c1-10; }
sed -e "s|href=\"style.css\"|href=\"style.css?v=$(version style.css)\"|" \
  -e "s|src=\"copy.js\"|src=\"copy.js?v=$(version copy.js)\"|" site/index.html > "$out/index.html"
# The images stay where README and the social preview use them; the page gets copies.
cp Resources/Icon/AppIcon.svg "$out/icon.svg"
cp docs/demo.gif "$out/demo.gif"
cp docs/social/preview.png "$out/preview.png"
# Every local file the page refers to must exist.
grep -oE '(src|href)="[^":#]+"' "$out/index.html" | sed -E 's/^[a-z]+="//; s/"$//; s/[?].*//' | grep -v '^\./$' | sort -u |
  while read -r ref; do
    test -f "$out/$ref" || { echo "site: index.html refers to missing $ref" >&2; exit 1; }
  done
echo "site: $out"
