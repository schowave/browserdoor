#!/bin/sh
#MISE description="Render the Homebrew formula: render-formula <version> <sha256>"
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"
version="${1:?usage: render-formula <version> <sha256>}"
sha="${2:?usage: render-formula <version> <sha256>}"
sed -e "s/@VERSION@/${version}/g" -e "s/@SHA256@/${sha}/g" -e '/^# /d' packaging/homebrew/doorman.rb
