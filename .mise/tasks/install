#!/bin/sh
#MISE description="Install Doorman.app and bin/doorman into $PREFIX (used by the Homebrew formula)"
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"
: "${PREFIX:?set PREFIX, e.g. PREFIX=/usr/local}"
"$(dirname "$0")/app"
mkdir -p "$PREFIX/bin"
rm -rf "${PREFIX:?}/$APP_NAME.app"
cp -R "$APP" "$PREFIX/$APP_NAME.app"
printf '#!/bin/sh\nexec open "%s" "$@"\n' "$PREFIX/$APP_NAME.app" > "$PREFIX/bin/doorman"
chmod +x "$PREFIX/bin/doorman"
