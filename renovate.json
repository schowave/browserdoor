{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Weekly: all dependency updates in one PR, merged automatically when CI is green. The merge triggers a patch release (auto-release.yml).",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "dependencyDashboard": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "One weekly PR for everything, majors included",
      "matchPackageNames": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all",
      "separateMajorMinor": false,
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ]
}
